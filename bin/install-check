#!/usr/bin/env bash
# Installs a released board on this machine from its archive alone, and runs
# the commands a fresh machine needs: init, plugin enable of the built-in
# tasks plugin, put and call. release.yml runs this on each runner before it
# publishes; run it by hand against a tarball of target/release/board.
#
#   bin/install-check <board archive> [<expected version>]
set -euo pipefail

board_archive=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
expected=${2:-}

home=$(mktemp -d)
mkdir -p "$home/bin" "$home/data" "$home/cache" "$home/config" "$home/repo"
tar -C "$home/bin" -xzf "$board_archive"
export PATH="$home/bin:$PATH" HOME="$home" XDG_DATA_HOME="$home/data" XDG_CACHE_HOME="$home/cache" XDG_CONFIG_HOME="$home/config"

version=$(board --version)
echo "$version"
if [ -n "$expected" ] && [ "$version" != "board $expected" ]; then
  echo "board --version printed '$version', and the release is $expected" >&2
  exit 1
fi

cd "$home/repo"
git init --quiet
git config user.name "Install Check"
git config user.email "install-check@example.com"
board init
board plugin enable tasks
printf -- '---\n$type: tasks/task/v2\ntitle: Install the release\nstatus: open\n---\n' | board put /tasks/install.md --file
board call tasks.available --repo / --json | grep -q '"Install the release"'
echo "installed board from its archive, and put and call ran"
rm -r "$home"

#!/usr/bin/env bash
# Every test gate. Nextest does not run doctests, so they run separately.
# With no argument it runs every part. CI runs one part per job:
# `bin/test rust [nextest options]`, `bin/test doc` and `bin/test python`.
set -euo pipefail
cd "$(dirname "$0")/.."
part=${1:-all}
case $part in all | rust | doc | python) ;; *) echo "usage: bin/test [rust [nextest options]|doc|python]" >&2; exit 2 ;; esac
shift || true

# A test that runs board must give it a cache directory of its own, or its
# runs write their index and timing log into the developer's ~/.cache. Here
# the tests inherit an empty cache directory instead. If board writes there,
# a test let it inherit the cache, and the gate fails. Other tools, such as
# mise, may write their own directories there.
inherited=$(mktemp -d)
# Every test, Rust and Python, runs with an empty config directory, so a
# board run outside a board never reads the developer's known boards.
config=$(mktemp -d)
logs=$(mktemp -d)
trap 'rm -rf "$inherited" "$config" "$logs"' EXIT
export XDG_CONFIG_HOME="$config"

if [ "$part" = all ] || [ "$part" = rust ]; then
  XDG_CACHE_HOME="$inherited" cargo nextest run --workspace --all-features --locked "$@"
  if [ -e "$inherited/board" ]; then
    echo "error: a test ran board with the cache directory it inherited; give it its own:" >&2
    find "$inherited/board" -type f >&2
    exit 1
  fi
fi

if [ "$part" = all ] || [ "$part" = doc ]; then
  cargo test --workspace --all-features --locked --doc
fi

# The Python tests run the workspace's debug build of board. Each project's
# suite spends most of its time waiting on board and plugin processes, so the
# suites run at once and each prints its output when it ends.
if [ "$part" = all ] || [ "$part" = python ]; then
  cargo build -p board-cli --locked
  projects=(python/board-plugin plugins/tasks plugins/controls plugins/evals plugins/runs plugins/share plugins/notes)
  pids=()
  for project in "${projects[@]}"; do
    (cd "$project" && uv run --locked pytest) > "$logs/${project//\//-}" 2>&1 &
    pids+=($!)
  done
  failed=0
  for i in "${!projects[@]}"; do
    status=0
    wait "${pids[$i]}" || status=$?
    echo "== ${projects[$i]}"
    cat "$logs/${projects[$i]//\//-}"
    [ "$status" -eq 0 ] || failed=1
  done
  exit "$failed"
fi

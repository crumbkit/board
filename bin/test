#!/usr/bin/env bash
# Every test gate. Nextest does not run doctests, so they run separately.
# With no argument it runs every part. CI runs one part per job:
# `bin/test rust [nextest options]`, `bin/test doc` and `bin/test ui`.
set -euo pipefail
cd "$(dirname "$0")/.."
part=${1:-all}
case $part in all | rust | doc | ui) ;; *) echo "usage: bin/test [rust [nextest options]|doc|ui]" >&2; exit 2 ;; esac
shift || true

# A test that runs board must give it a cache directory of its own, or its
# runs write their index and timing log into the developer's ~/.cache. Here
# the tests inherit an empty cache directory instead. If board writes there,
# a test let it inherit the cache, and the gate fails. Other tools, such as
# mise, may write their own directories there.
inherited=$(mktemp -d)
# Every test runs with an empty config directory, so a
# board run outside a board never reads the developer's known boards.
config=$(mktemp -d)
trap 'rm -rf "$inherited" "$config"' EXIT
export XDG_CONFIG_HOME="$config"

if [ "$part" = all ] || [ "$part" = rust ]; then
  XDG_CACHE_HOME="$inherited" cargo nextest run --workspace --all-features --locked "$@"
  if [ -e "$inherited/board" ]; then
    echo "error: a test ran board with the cache directory it inherited; give it its own:" >&2
    find "$inherited/board" -type f >&2
    exit 1
  fi
fi

if [ "$part" = all ] || [ "$part" = doc ]; then
  cargo test --workspace --all-features --locked --doc
fi

# board-ui's stories, each compared with its golden screenshot in both themes.
if [ "$part" = all ] || [ "$part" = ui ]; then
  bin/ui-goldens
fi


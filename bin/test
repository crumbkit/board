#!/usr/bin/env bash
# Every test gate. Nextest does not run doctests, so they run separately.
set -euo pipefail
cd "$(dirname "$0")/.."

# A test that runs board must give it a cache directory of its own, or its
# runs write their index and timing log into the developer's ~/.cache. Here
# the tests inherit an empty cache directory instead. If board writes there,
# a test let it inherit the cache, and the gate fails. Other tools, such as
# mise, may write their own directories there.
inherited=$(mktemp -d)
trap 'rm -rf "$inherited"' EXIT
XDG_CACHE_HOME="$inherited" cargo nextest run --workspace --all-features --locked
if [ -e "$inherited/board" ]; then
  echo "error: a test ran board with the cache directory it inherited; give it its own:" >&2
  find "$inherited/board" -type f >&2
  exit 1
fi

cargo test --workspace --all-features --locked --doc

{
  "$type": "board/plugin-manifest/v1",
  "capabilities": [
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Write the workflows /workflows/personal and /workflows/work when they are missing.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "Nothing: `seed` writes the workflows it ships.",
        "properties": {},
        "title": "SeedInput",
        "type": "object"
      },
      "name": "seed",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The workflows `seed` wrote; those already there are left as they are.",
        "properties": {
          "written": {
            "items": {
              "type": "string"
            },
            "title": "Written",
            "type": "array"
          }
        },
        "required": [
          "written"
        ],
        "title": "SeedOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Start a change to the repository of the clone Board runs in: its repo record when it has none, the change with its branch, workflow, suite and route, and its first claim; return the repository's owners and contributing docs.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "Start a change to the repository of the clone Board was started in.",
        "properties": {
          "handle": {
            "description": "Whose change this is, as CODEOWNERS names people, such as @luke; sets the route.",
            "title": "Handle",
            "type": "string"
          },
          "issue": {
            "description": "The URL of the issue the change answers.",
            "pattern": "^https?://",
            "title": "Issue",
            "type": "string"
          },
          "name": {
            "description": "The change's name, so it lives at /changes/<name>; made from the title when left out.",
            "title": "Name",
            "type": "string"
          },
          "repo-name": {
            "description": "The name of a new repo record, /repos/<name>; the remote's last segment when left out.",
            "title": "Repo-Name",
            "type": "string"
          },
          "session": {
            "description": "The session starting the change, which its first claim names.",
            "pattern": "\\S",
            "title": "Session",
            "type": "string"
          },
          "suite": {
            "description": "The check suite, a runs/suite/v1; read from the contributing docs when left out.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Suite",
            "type": "string"
          },
          "title": {
            "description": "What the change does, in a few words.",
            "pattern": "[A-Za-z0-9]",
            "title": "Title",
            "type": "string"
          },
          "workflow": {
            "description": "The workflow, a changes/workflow/v1; chosen by the repository when left out.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Workflow",
            "type": "string"
          }
        },
        "required": [
          "title",
          "session"
        ],
        "title": "StartInput",
        "type": "object"
      },
      "name": "start",
      "outputSchema": {
        "$defs": {
          "Rule": {
            "additionalProperties": false,
            "description": "One CODEOWNERS line: a pattern and the owners of the files it matches.",
            "properties": {
              "owners": {
                "items": {
                  "type": "string"
                },
                "title": "Owners",
                "type": "array"
              },
              "pattern": {
                "title": "Pattern",
                "type": "string"
              }
            },
            "required": [
              "pattern",
              "owners"
            ],
            "title": "Rule",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "The new change, its repository and the repository's brief.\n\n`repo` is the repo record, and `repo_created` says whether `start` wrote\nit. `claim` is the first claim. `owners` lists the CODEOWNERS rules from\n`codeowners`, the file read, and `ask_first` the patterns someone other\nthan `handle` owns. `docs` lists the contributing docs found, to read\nbefore designing.",
        "properties": {
          "ask_first": {
            "items": {
              "type": "string"
            },
            "title": "Ask First",
            "type": "array"
          },
          "branch": {
            "title": "Branch",
            "type": "string"
          },
          "claim": {
            "title": "Claim",
            "type": "string"
          },
          "codeowners": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Codeowners"
          },
          "docs": {
            "items": {
              "type": "string"
            },
            "title": "Docs",
            "type": "array"
          },
          "owners": {
            "items": {
              "$ref": "#/$defs/Rule"
            },
            "title": "Owners",
            "type": "array"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "repo": {
            "title": "Repo",
            "type": "string"
          },
          "repo_created": {
            "title": "Repo Created",
            "type": "boolean"
          },
          "route": {
            "enum": [
              "owner",
              "ask-first",
              "unowned",
              "unread"
            ],
            "title": "Route",
            "type": "string"
          },
          "suite": {
            "title": "Suite",
            "type": "string"
          },
          "workflow": {
            "title": "Workflow",
            "type": "string"
          }
        },
        "required": [
          "path",
          "repo",
          "repo_created",
          "branch",
          "workflow",
          "suite",
          "route",
          "claim",
          "owners",
          "ask_first",
          "codeowners",
          "docs"
        ],
        "title": "StartOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Write a plan for the change and the records it uses, refusing a reference that reaches nothing, a plan over 3,000 words and used documents over 3,000 words in all; the newest plan is the change's plan.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "A plan for a change, given on stdin because `uses` is an array.",
        "properties": {
          "path": {
            "description": "The change's logical path, such as /changes/suite-timeout.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          },
          "text": {
            "description": "The plan in Markdown, at most 3,000 words.",
            "pattern": "\\S",
            "title": "Text",
            "type": "string"
          },
          "uses": {
            "description": "The records and documents the plan relies on; the documents hold at most 3,000 words in all.",
            "items": {
              "format": "board-path",
              "pattern": "^/",
              "type": "string"
            },
            "title": "Uses",
            "type": "array"
          }
        },
        "required": [
          "path",
          "text",
          "uses"
        ],
        "title": "PlanInput",
        "type": "object"
      },
      "name": "plan",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The plan record written, its text, and how many references it uses.",
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "uses": {
            "title": "Uses",
            "type": "integer"
          }
        },
        "required": [
          "path",
          "text",
          "uses"
        ],
        "title": "PlanOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": true
      },
      "description": "What an agent needs to start: the newest plan, one line per record it uses, the next step and the command that lists the repository's controls, in at most 600 words.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "One change, by path.",
        "properties": {
          "path": {
            "description": "The change's logical path, such as /changes/suite-timeout.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "PathInput",
        "type": "object"
      },
      "name": "brief",
      "outputSchema": {
        "$defs": {
          "BriefUse": {
            "additionalProperties": false,
            "description": "One record the plan uses, and one line saying what it holds.",
            "properties": {
              "line": {
                "title": "Line",
                "type": "string"
              },
              "ref": {
                "title": "Ref",
                "type": "string"
              }
            },
            "required": [
              "ref",
              "line"
            ],
            "title": "BriefUse",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "What an agent needs to start a change, in at most 600 words.\n\n`plan` is the newest plan's text, or `null` when the change has no plan\nrecord. `uses` gives one line per record it uses, in order, and\n`left_out` counts those the word limit left out. `controls` is the\ncommand that lists the controls on the caller's repository.",
        "properties": {
          "actor": {
            "anyOf": [
              {
                "enum": [
                  "agent",
                  "reviewer",
                  "owner"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor"
          },
          "controls": {
            "title": "Controls",
            "type": "string"
          },
          "left_out": {
            "title": "Left Out",
            "type": "integer"
          },
          "next": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "plan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan"
          },
          "uses": {
            "items": {
              "$ref": "#/$defs/BriefUse"
            },
            "title": "Uses",
            "type": "array"
          }
        },
        "required": [
          "path",
          "plan",
          "uses",
          "left_out",
          "next",
          "actor",
          "controls"
        ],
        "title": "BriefOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Record that a session holds the change, and the root of the clone Board runs in as its worktree.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "Claim a change for a session, from the clone it works in.",
        "properties": {
          "path": {
            "description": "The change's logical path, such as /changes/suite-timeout.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          },
          "session": {
            "description": "The session that holds the change from now on.",
            "pattern": "\\S",
            "title": "Session",
            "type": "string"
          }
        },
        "required": [
          "path",
          "session"
        ],
        "title": "ClaimInput",
        "type": "object"
      },
      "name": "claim",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The claim written and the worktree it names.",
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "worktree": {
            "title": "Worktree",
            "type": "string"
          }
        },
        "required": [
          "path",
          "worktree"
        ],
        "title": "ClaimOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Record the paths the branch touches at a head, which decide the steps controls add.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "The paths the branch touches at a head, given on stdin because `files` is an array.",
        "properties": {
          "files": {
            "description": "Paths relative to the repository's root, as git diff --name-only gives.",
            "items": {
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          },
          "head": {
            "description": "The commit the paths were read at.",
            "pattern": "^[0-9a-f]{7,64}$",
            "title": "Head",
            "type": "string"
          },
          "path": {
            "description": "The change's logical path, such as /changes/suite-timeout.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "head",
          "files"
        ],
        "title": "FilesInput",
        "type": "object"
      },
      "name": "files",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The record written.",
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "Written",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Record a run of the check suite; the commit it names under the repo record's name is the change's head.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "Record a run of the check suite at the head it names.",
        "properties": {
          "path": {
            "description": "The change's logical path, such as /changes/suite-timeout.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          },
          "run": {
            "description": "The runs/run/v1 the suite wrote, such as /suites/<name>/runs/<id>.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Run",
            "type": "string"
          }
        },
        "required": [
          "path",
          "run"
        ],
        "title": "CheckInput",
        "type": "object"
      },
      "name": "check",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The check written and the head its run names.",
        "properties": {
          "head": {
            "title": "Head",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "head"
        ],
        "title": "CheckOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": true
      },
      "description": "The change's steps, each done or not with the record that did it, and the next step and its actor.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "One change, by path.",
        "properties": {
          "path": {
            "description": "The change's logical path, such as /changes/suite-timeout.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "PathInput",
        "type": "object"
      },
      "name": "next",
      "outputSchema": {
        "$defs": {
          "StepState": {
            "additionalProperties": false,
            "description": "One step of the change: whether it is done and by which record.\n\n`added_by` is the control that added the step, `route` for the approve\nstep a route adds, or null for a step of the workflow. `if_touched` says\na control adds the step only if the branch touches its files, which no\nfiles record at the head says yet; record the files with `files` to\nsettle it.",
            "properties": {
              "actor": {
                "enum": [
                  "agent",
                  "reviewer",
                  "owner"
                ],
                "title": "Actor",
                "type": "string"
              },
              "added_by": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Added By"
              },
              "done": {
                "title": "Done",
                "type": "boolean"
              },
              "done_by": {
                "enum": [
                  "plan",
                  "answer",
                  "check",
                  "review",
                  "landed"
                ],
                "title": "Done By",
                "type": "string"
              },
              "if_touched": {
                "title": "If Touched",
                "type": "boolean"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "record": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Record"
              }
            },
            "required": [
              "name",
              "actor",
              "done_by",
              "done",
              "record",
              "added_by",
              "if_touched"
            ],
            "title": "StepState",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Where the change stands: its head, its steps, the next step and its actor, and how it ended.",
        "properties": {
          "actor": {
            "anyOf": [
              {
                "enum": [
                  "agent",
                  "reviewer",
                  "owner"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor"
          },
          "ended": {
            "anyOf": [
              {
                "enum": [
                  "landed",
                  "dropped"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended"
          },
          "head": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Head"
          },
          "next": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/$defs/StepState"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "path",
          "head",
          "steps",
          "next",
          "actor",
          "ended"
        ],
        "title": "NextOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "End the change as merged at a commit.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "End the change as merged.",
        "properties": {
          "commit": {
            "description": "The merge commit.",
            "pattern": "^[0-9a-f]{7,64}$",
            "title": "Commit",
            "type": "string"
          },
          "path": {
            "description": "The change's logical path, such as /changes/suite-timeout.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "commit"
        ],
        "title": "LandedInput",
        "type": "object"
      },
      "name": "landed",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The record written.",
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "Written",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "End the change as stopped, saying why.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "End the change as stopped.",
        "properties": {
          "path": {
            "description": "The change's logical path, such as /changes/suite-timeout.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          },
          "why": {
            "description": "Why the change stopped.",
            "pattern": "\\S",
            "title": "Why",
            "type": "string"
          }
        },
        "required": [
          "path",
          "why"
        ],
        "title": "DropInput",
        "type": "object"
      },
      "name": "drop",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The record written.",
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "Written",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": true
      },
      "description": "The changes that have not ended, with their repository, branch, route, holder and worktree.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "The changes that have not ended, by path.",
        "properties": {
          "branch": {
            "description": "Only the changes on this branch.",
            "minLength": 1,
            "title": "Branch",
            "type": "string"
          },
          "holder": {
            "description": "Only the changes whose newest claim names this session.",
            "pattern": "\\S",
            "title": "Holder",
            "type": "string"
          },
          "limit": {
            "description": "The most changes to return, 1 to 10,000; 100 when left out.",
            "maximum": 10000,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "remote": {
            "description": "Only the changes to this repository, by its remote, such as owner/name or its origin URL.",
            "minLength": 1,
            "title": "Remote",
            "type": "string"
          }
        },
        "title": "OpenInput",
        "type": "object"
      },
      "name": "open",
      "outputSchema": {
        "$defs": {
          "OpenChange": {
            "additionalProperties": false,
            "description": "A change that has not ended, with the session and worktree its newest claim names, or null without one.",
            "properties": {
              "branch": {
                "title": "Branch",
                "type": "string"
              },
              "holder": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Holder"
              },
              "path": {
                "title": "Path",
                "type": "string"
              },
              "repo": {
                "title": "Repo",
                "type": "string"
              },
              "route": {
                "enum": [
                  "owner",
                  "ask-first",
                  "unowned",
                  "unread"
                ],
                "title": "Route",
                "type": "string"
              },
              "title": {
                "title": "Title",
                "type": "string"
              },
              "worktree": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Worktree"
              }
            },
            "required": [
              "path",
              "title",
              "repo",
              "branch",
              "route",
              "holder",
              "worktree"
            ],
            "title": "OpenChange",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Changes with no landed or dropped record, by path.\n\n`total` counts every open change and `truncated` says whether the limit\nleft some out. `unreadable` is how many were left out because Board marks\nthem degraded.",
        "properties": {
          "changes": {
            "items": {
              "$ref": "#/$defs/OpenChange"
            },
            "title": "Changes",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          },
          "unreadable": {
            "title": "Unreadable",
            "type": "integer"
          }
        },
        "required": [
          "changes",
          "total",
          "truncated",

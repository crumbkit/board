{
  "$type": "board/plugin-manifest/v1",
  "capabilities": [
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Create a change and its plan to fill in, set its route from CODEOWNERS, and return the repository's owners, contributing docs and check suite.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "Create a change in `plan` for a mounted repository.",
        "properties": {
          "handle": {
            "description": "Whose change this is, as CODEOWNERS names people, such as @luke; sets the route.",
            "title": "Handle",
            "type": "string"
          },
          "mount": {
            "description": "The repository's mount, such as /repos/board.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Mount",
            "type": "string"
          },
          "name": {
            "description": "The change's name, so it lives at /changes/<name>; made from the title when left out.",
            "title": "Name",
            "type": "string"
          },
          "title": {
            "description": "What the change does, in a few words.",
            "pattern": "[A-Za-z0-9]",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "mount",
          "title"
        ],
        "title": "StartInput",
        "type": "object"
      },
      "name": "start",
      "outputSchema": {
        "$defs": {
          "Rule": {
            "additionalProperties": false,
            "description": "One CODEOWNERS line: a pattern and the owners of the files it matches.",
            "properties": {
              "owners": {
                "items": {
                  "type": "string"
                },
                "title": "Owners",
                "type": "array"
              },
              "pattern": {
                "title": "Pattern",
                "type": "string"
              }
            },
            "required": [
              "pattern",
              "owners"
            ],
            "title": "Rule",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "The new change and the repository's brief.\n\n`owners` lists the CODEOWNERS rules from `codeowners`, the file read, and\n`ask_first` the patterns someone other than `handle` owns. `docs` lists\nthe contributing docs found, to read before designing. `suite` is the\ncheck suite they name as a `runs/suite/v1` path, or `null`.",
        "properties": {
          "ask_first": {
            "items": {
              "type": "string"
            },
            "title": "Ask First",
            "type": "array"
          },
          "codeowners": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Codeowners"
          },
          "docs": {
            "items": {
              "type": "string"
            },
            "title": "Docs",
            "type": "array"
          },
          "owners": {
            "items": {
              "$ref": "#/$defs/Rule"
            },
            "title": "Owners",
            "type": "array"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "plan": {
            "title": "Plan",
            "type": "string"
          },
          "route": {
            "enum": [
              "owner",
              "ask-first",
              "unowned"
            ],
            "title": "Route",
            "type": "string"
          },
          "suite": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suite"
          }
        },
        "required": [
          "path",
          "plan",
          "route",
          "owners",
          "ask_first",
          "codeowners",
          "docs",
          "suite"
        ],
        "title": "StartOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": true
      },
      "description": "The change's phase, each check of its gate as pass or missing, and what to do now.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "One change, by path.",
        "properties": {
          "path": {
            "description": "The change's logical path, such as /changes/suite-timeout.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "PathInput",
        "type": "object"
      },
      "name": "next",
      "outputSchema": {
        "$defs": {
          "Check": {
            "additionalProperties": false,
            "description": "One requirement of the phase's gate: `pass`, or `missing` with what is missing in `detail`.",
            "properties": {
              "check": {
                "title": "Check",
                "type": "string"
              },
              "detail": {
                "title": "Detail",
                "type": "string"
              },
              "status": {
                "enum": [
                  "pass",
                  "missing"
                ],
                "title": "Status",
                "type": "string"
              }
            },
            "required": [
              "check",
              "status",
              "detail"
            ],
            "title": "Check",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Where the change stands: its phase, route, the gate's checks and what to do now.",
        "properties": {
          "gate": {
            "items": {
              "$ref": "#/$defs/Check"
            },
            "title": "Gate",
            "type": "array"
          },
          "instruction": {
            "title": "Instruction",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "phase": {
            "enum": [
              "plan",
              "build",
              "review",
              "land",
              "done",
              "dropped"
            ],
            "title": "Phase",
            "type": "string"
          },
          "route": {
            "anyOf": [
              {
                "enum": [
                  "owner",
                  "ask-first",
                  "unowned"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route"
          }
        },
        "required": [
          "path",
          "phase",
          "route",
          "gate",
          "instruction"
        ],
        "title": "NextOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Add a reference to a record the change produced, or set its route, head commit or pull request.",
      "inputSchema": {
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "ref"
            ]
          },
          {
            "required": [
              "ticket"
            ]
          },
          {
            "required": [
              "pull"
            ]
          },
          {
            "required": [
              "route"
            ]
          },
          {
            "required": [
              "head"
            ]
          },
          {
            "required": [
              "issue"
            ]
          },
          {
            "required": [
              "pull_request"
            ]
          }
        ],
        "description": "Add a record, ticket or pull reference to a change, or set its route, head commit, issue or pull request.",
        "properties": {
          "head": {
            "description": "The commit under test and review.",
            "pattern": "^[0-9a-f]{7,40}$",
            "title": "Head",
            "type": "string"
          },
          "issue": {
            "description": "The URL of the issue the change answers.",
            "pattern": "^https?://",
            "title": "Issue",
            "type": "string"
          },
          "path": {
            "description": "The change's logical path, such as /changes/suite-timeout.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          },
          "pull": {
            "description": "A pull request of the change, a github/pull/v1 record.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Pull",
            "type": "string"
          },
          "pull_request": {
            "description": "The pull request's URL.",
            "pattern": "^https?://",
            "title": "Pull Request",
            "type": "string"
          },
          "ref": {
            "description": "A record the change produced, such as /suites/board-tests/runs/<id>.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Ref",
            "type": "string"
          },
          "route": {
            "description": "The route: owner, ask-first or unowned.",
            "enum": [
              "owner",
              "ask-first",
              "unowned"
            ],
            "title": "Route",
            "type": "string"
          },
          "ticket": {
            "description": "A ticket the change works on, a jira/issue/v1 or github/issue/v1 record.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Ticket",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "AttachInput",
        "type": "object"
      },
      "name": "attach",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The change written, and how many records it now references.",
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "records": {
            "title": "Records",
            "type": "integer"
          }
        },
        "required": [
          "path",
          "records"
        ],
        "title": "AttachOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Move the change to its next phase when its gate passes; otherwise refuse and list what is missing.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "One change, by path.",
        "properties": {
          "path": {
            "description": "The change's logical path, such as /changes/suite-timeout.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "PathInput",
        "type": "object"
      },
      "name": "advance",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The phase the change left and the phase it entered.",
        "properties": {
          "from": {
            "enum": [
              "plan",
              "build",
              "review",
              "land",
              "done",
              "dropped"
            ],
            "title": "From",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "to": {
            "enum": [
              "plan",
              "build",
              "review",
              "land",
              "done",
              "dropped"
            ],
            "title": "To",
            "type": "string"
          }
        },
        "required": [
          "path",
          "from",
          "to"
        ],
        "title": "AdvanceOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": true
      },
      "description": "The changes that are not done or dropped, with their phase and route.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "The changes that are not done or dropped, by path.",
        "properties": {
          "limit": {
            "default": 100,
            "description": "The most changes to return, 1 to 10,000; 100 when left out.",
            "maximum": 10000,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "OpenInput",
        "type": "object"
      },
      "name": "open",
      "outputSchema": {
        "$defs": {
          "OpenChange": {
            "additionalProperties": false,
            "description": "A change that is not done or dropped.",
            "properties": {
              "mount": {
                "title": "Mount",
                "type": "string"
              },
              "path": {
                "title": "Path",
                "type": "string"
              },
              "phase": {
                "enum": [
                  "plan",
                  "build",
                  "review",
                  "land",
                  "done",
                  "dropped"
                ],
                "title": "Phase",
                "type": "string"
              },
              "route": {
                "anyOf": [
                  {
                    "enum": [
                      "owner",
                      "ask-first",
                      "unowned"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Route"
              },
              "title": {
                "title": "Title",
                "type": "string"
              }
            },
            "required": [
              "path",
              "title",
              "mount",
              "phase",
              "route"
            ],
            "title": "OpenChange",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Open changes by path.\n\n`total` counts every open change and `truncated` says whether the limit\nleft some out. `unreadable` is how many were left out because Board marks\nthem degraded.",
        "properties": {
          "changes": {
            "items": {
              "$ref": "#/$defs/OpenChange"
            },
            "title": "Changes",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          },
          "unreadable": {
            "title": "Unreadable",
            "type": "integer"
          }
        },
        "required": [
          "changes",
          "total",
          "truncated",
          "unreadable"
        ],
        "title": "OpenOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Write pr.md in the change's directory, a pull request body that says what changes, why, what the tests prove and do not prove, and the evidence, and return the gh command that would use it.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "One change, by path.",
        "properties": {
          "path": {
            "description": "The change's logical path, such as /changes/suite-timeout.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "PathInput",
        "type": "object"
      },
      "name": "pr",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The pull request drafted for a change.\n\n`path` is the logical path of `pr.md`, which holds the body. `command` is\nthe `gh pr create` line, for a POSIX shell, that would open the pull\nrequest with that body; the plugin never runs it. When the change already\nrecords a pull request, `command` is `null`, `pull_request` holds its\nURL and `pr.md` is not written. `unreadable` lists the references that reach nothing or that Board\nmarks degraded.",
        "properties": {
          "command": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Command"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "pull_request": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pull Request"
          },
          "unreadable": {
            "items": {
              "type": "string"
            },
            "title": "Unreadable",
            "type": "array"
          }
        },
        "required": [
          "path",
          "command",
          "pull_request",
          "unreadable"
        ],
        "title": "PrOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Write a plan for the change and the records it uses, refusing a reference that reaches nothing, a plan over 3,000 words and used documents over 3,000 words in all; the newest plan is the change's plan.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "A plan for a change, given on stdin because `uses` is an array.",
        "properties": {
          "path": {
            "description": "The change's logical path, such as /changes/suite-timeout.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          },
          "text": {
            "description": "The plan in Markdown, at most 3,000 words.",
            "pattern": "\\S",
            "title": "Text",
            "type": "string"
          },
          "uses": {
            "description": "The records and documents the plan relies on; the documents hold at most 3,000 words in all.",
            "items": {
              "format": "board-path",
              "pattern": "^/",
              "type": "string"
            },
            "title": "Uses",
            "type": "array"
          }
        },
        "required": [
          "path",
          "text",
          "uses"
        ],
        "title": "PlanInput",
        "type": "object"
      },
      "name": "plan",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The plan record written, its text, and how many references it uses.",
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "uses": {
            "title": "Uses",
            "type": "integer"
          }
        },
        "required": [
          "path",
          "text",
          "uses"
        ],
        "title": "PlanOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": true
      },
      "description": "What an agent needs to start: the newest plan, one line per record it uses, the next step and the command that lists the repository's controls, in at most 600 words.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "One change, by path.",
        "properties": {
          "path": {
            "description": "The change's logical path, such as /changes/suite-timeout.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "PathInput",
        "type": "object"
      },
      "name": "brief",
      "outputSchema": {
        "$defs": {
          "BriefUse": {
            "additionalProperties": false,
            "description": "One record the plan uses, and one line saying what it holds.",
            "properties": {
              "line": {
                "title": "Line",
                "type": "string"
              },
              "ref": {
                "title": "Ref",
                "type": "string"
              }
            },
            "required": [
              "ref",
              "line"
            ],
            "title": "BriefUse",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "What an agent needs to start a change, in at most 600 words.\n\n`plan` is the newest plan's text, or `null` when the change has no plan\nrecord. `uses` gives one line per record it uses, in order, and\n`left_out` counts those the word limit left out. `controls` is the\ncommand that lists the controls on the change's repository.\n`brief_line`, `board-brief: <path>`, comes first in the output; a\nbuilder's first message starts with it, and the write guard reads it.",
        "properties": {
          "brief_line": {
            "title": "Brief Line",
            "type": "string"
          },
          "controls": {
            "title": "Controls",
            "type": "string"
          },
          "instruction": {
            "title": "Instruction",
            "type": "string"
          },
          "left_out": {
            "title": "Left Out",
            "type": "integer"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "phase": {
            "enum": [
              "plan",
              "build",
              "review",
              "land",
              "done",
              "dropped"
            ],
            "title": "Phase",
            "type": "string"
          },
          "plan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan"
          },
          "uses": {
            "items": {
              "$ref": "#/$defs/BriefUse"
            },
            "title": "Uses",
            "type": "array"
          }
        },
        "required": [
          "brief_line",
          "path",
          "plan",
          "uses",
          "left_out",
          "phase",
          "instruction",
          "controls"
        ],
        "title": "BriefOutput",
        "type": "object"
      }
    }
  ],
  "description": "Walk one change to a repository from its plan to its pull request, and gather every record it produces. Use it when you start a change to a repository mounted in the board, and whenever you resume one. Start with `board -C <board> call changes.start --mount /repos/<name> --title '<title>'`, then call `changes.next --path /changes/<name>` for the next step. SKILL.md and README.md in the plugin's directory say more.",
  "metadata": {
    "area": "delivery"
  },
  "name": "changes",
  "run": [
    "uv",
    "run",
    "--frozen",
    "--no-dev",
    "python",
    "-m",
    "board_changes"
  ],
  "types": [
    "changes/change/v1",
    "changes/plan/v1"
  ],
  "version": "0.1.0"
}

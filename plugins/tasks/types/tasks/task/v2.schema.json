{
  "dependentRequired": {
    "ephemeral": [
      "repeat"
    ]
  },
  "description": "`tasks/task/v2`: the frontmatter of a Markdown task under `tasks/`, whose body holds its prose.\n\n`defer` hides the task until a date, a date-time or a horizon after `reviewed`.\n`after` references the tasks in the same repo that it waits on. `repeat`\nnames when a repeating task comes back, and `ephemeral` that a missed day\nis not kept. `from_hour` is the hour of the person's day it is available\nfrom. `contexts` tags where it can be done. `reviewed` is the day it was\nlast looked at. `owner` names the agent or person who holds it, such as a\nsession id or a handle. `parent` references the task in the same repo that\nthis one is part of, and `kind` says whether it is a `task`, as when it is\nleft out, or a `project`, whose `brief` may reference a brief such as a\nREADME.md. Any other field, such as Reflect's `id` and `pinned`, is\nadmitted and ignored.",
  "properties": {
    "$type": {
      "const": "tasks/task/v2",
      "title": "$Type",
      "type": "string"
    },
    "after": {
      "items": {
        "format": "board-ref",
        "type": "string",
        "x-board-type": "tasks/task/v2"
      },
      "title": "After",
      "type": "array"
    },
    "brief": {
      "format": "board-ref",
      "title": "Brief",
      "type": "string"
    },
    "contexts": {
      "items": {
        "pattern": "^[a-z0-9-]+$",
        "type": "string"
      },
      "title": "Contexts",
      "type": "array"
    },
    "defer": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "enum": [
            "not-today",
            "not-this-week",
            "soon",
            "someday"
          ],
          "type": "string"
        }
      ],
      "title": "Defer"
    },
    "due": {
      "format": "date",
      "title": "Due",
      "type": "string"
    },
    "ephemeral": {
      "title": "Ephemeral",
      "type": "boolean"
    },
    "from_hour": {
      "maximum": 23,
      "minimum": 0,
      "title": "From Hour",
      "type": "integer"
    },
    "kind": {
      "enum": [
        "task",
        "project"
      ],
      "title": "Kind",
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "parent": {
      "format": "board-ref",
      "title": "Parent",
      "type": "string",
      "x-board-type": "tasks/task/v2"
    },
    "repeat": {
      "pattern": "^(daily|weekdays|weekly-(mon|tue|wed|thu|fri|sat|sun)|monthly-([1-9]|[12][0-9]|3[01])|annually-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))$",
      "title": "Repeat",
      "type": "string"
    },
    "reviewed": {
      "format": "date",
      "title": "Reviewed",
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "done",
        "dropped"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "$type",
    "title",
    "status"
  ],
  "title": "Task",
  "type": "object"
}

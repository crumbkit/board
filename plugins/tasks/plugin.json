{
  "$type": "board/plugin-manifest/v1",
  "capabilities": [
    {
      "_meta": {},
      "description": "Sync the repos the caller's remote chooses, then list their open tasks available now, those due within seven days, the stale ones, and those an owner holds.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "The tasks to sweep now, in the repos the caller's remote chooses.",
        "properties": {
          "context": {
            "description": "Only tasks tagged with this context, such as errands.",
            "title": "Context",
            "type": "string"
          },
          "owner": {
            "description": "Only tasks this owner, such as a session id, holds or nobody holds, and list in held the ones it holds that are not available.",
            "minLength": 1,
            "title": "Owner",
            "type": "string"
          },
          "remote": {
            "description": "A git remote, or owner/name, to choose the repos by in place of the origin of the directory board was started in.",
            "minLength": 1,
            "title": "Remote",
            "type": "string"
          },
          "repo": {
            "description": "One repo's tasks: / for the board's own tree, or a notes repo's mount path such as /repos/notes-personal; the caller's git remote chooses the repos when left out.",
            "title": "Repo",
            "type": "string"
          }
        },
        "title": "AvailableInput",
        "type": "object"
      },
      "name": "available",
      "outputSchema": {
        "$defs": {
          "CrossParent": {
            "additionalProperties": false,
            "description": "A `parent` that names a task in another notes repo than its task's own, which is not followed.",
            "properties": {
              "parent": {
                "title": "Parent",
                "type": "string"
              },
              "path": {
                "title": "Path",
                "type": "string"
              }
            },
            "required": [
              "path",
              "parent"
            ],
            "title": "CrossParent",
            "type": "object"
          },
          "CrossRepo": {
            "additionalProperties": false,
            "description": "An `after` that names a task in another notes repo than its task's own, which is not followed.",
            "properties": {
              "after": {
                "title": "After",
                "type": "string"
              },
              "path": {
                "title": "Path",
                "type": "string"
              }
            },
            "required": [
              "path",
              "after"
            ],
            "title": "CrossRepo",
            "type": "object"
          },
          "Section": {
            "additionalProperties": false,
            "description": "At most 100 tasks of a section, by repo then title, and how many it holds.",
            "properties": {
              "tasks": {
                "items": {
                  "$ref": "#/$defs/SweptTask"
                },
                "title": "Tasks",
                "type": "array"
              },
              "total": {
                "title": "Total",
                "type": "integer"
              }
            },
            "required": [
              "tasks",
              "total"
            ],
            "title": "Section",
            "type": "object"
          },
          "Subtasks": {
            "additionalProperties": false,
            "description": "How many of a task's descendants are open, and how many it has in every status.",
            "properties": {
              "open": {
                "title": "Open",
                "type": "integer"
              },
              "total": {
                "title": "Total",
                "type": "integer"
              }
            },
            "required": [
              "open",
              "total"
            ],
            "title": "Subtasks",
            "type": "object"
          },
          "SweptTask": {
            "additionalProperties": false,
            "description": "An open task: where it is, why it waits, how many open tasks wait on it, and its place in the tree.\n\n`parent` is the parent's path in the board, or None when it has none, names no task in its repo, or is\nwhere a loop was cut. `tree_path` joins the slugs from its root to it.",
            "properties": {
              "blocked_by": {
                "items": {
                  "type": "string"
                },
                "title": "Blocked By",
                "type": "array"
              },
              "contexts": {
                "items": {
                  "type": "string"
                },
                "title": "Contexts",
                "type": "array"
              },
              "defer": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Defer"
              },
              "due": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Due"
              },
              "owner": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Owner"
              },
              "parent": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Parent"
              },
              "path": {
                "title": "Path",
                "type": "string"
              },
              "repo": {
                "title": "Repo",
                "type": "string"
              },
              "reviewed": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Reviewed"
              },
              "subtasks": {
                "$ref": "#/$defs/Subtasks"
              },
              "title": {
                "title": "Title",
                "type": "string"
              },
              "tree_path": {
                "title": "Tree Path",
                "type": "string"
              },
              "waiting": {
                "title": "Waiting",
                "type": "integer"
              }
            },
            "required": [
              "repo",
              "path",
              "title",
              "due",
              "defer",
              "reviewed",
              "contexts",
              "owner",
              "blocked_by",
              "waiting",
              "parent",
              "subtasks",
              "tree_path"
            ],
            "title": "SweptTask",
            "type": "object"
          },
          "Unsynced": {
            "additionalProperties": false,
            "description": "A repo that did not sync, and the code why; its tasks are as its clone holds them.",
            "properties": {
              "code": {
                "title": "Code",
                "type": "string"
              },
              "repo": {
                "title": "Repo",
                "type": "string"
              }
            },
            "required": [
              "repo",
              "code"
            ],
            "title": "Unsynced",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "The sweep.\n\n`available` holds the open tasks not deferred, not blocked and past their\n`from_hour`. `due_soon` holds every open task due within seven days, or\noverdue. `stale` holds the open tasks not available or deferred that have\nno `reviewed`, or were reviewed over 14 days ago. With `--owner`, every\nsection keeps the tasks that owner or nobody holds, and `held` lists the\nones that owner holds that are not available; without it, `held` is empty.\n`repos` are the repos read, `degraded` counts their Markdown files under\n`tasks/` that are not a readable open `tasks/task/v2` task, or hold a date\nthat cannot be read, and `unsynced` lists the repos whose sync or pin\nfailed. `cross_repo` lists the `after` entries that name another repo's\ntask, which never block. `origin_unread` says why the caller's git\nrepository gave no origin, when it did not, so only `/` and the personal\nrepo were read.",
        "properties": {
          "available": {
            "$ref": "#/$defs/Section"
          },
          "cross_repo": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CrossRepo"
                },
                {
                  "$ref": "#/$defs/CrossParent"
                }
              ]
            },
            "title": "Cross Repo",
            "type": "array"
          },
          "degraded": {
            "title": "Degraded",
            "type": "integer"
          },
          "due_soon": {
            "$ref": "#/$defs/Section"
          },
          "held": {
            "$ref": "#/$defs/Section"
          },
          "origin_unread": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin Unread"
          },
          "repos": {
            "items": {
              "type": "string"
            },
            "title": "Repos",
            "type": "array"
          },
          "stale": {
            "$ref": "#/$defs/Section"
          },
          "unsynced": {
            "items": {
              "$ref": "#/$defs/Unsynced"
            },
            "title": "Unsynced",
            "type": "array"
          }
        },
        "required": [
          "available",
          "due_soon",
          "stale",
          "held",
          "repos",
          "degraded",
          "unsynced",
          "cross_repo",
          "origin_unread"
        ],
        "title": "AvailableOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "description": "List a task and its descendants in every status, nested by title, or with --root every top-level tree in the repos the caller's remote chooses, read at their pins.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "The tree to list: one task's, or every top-level node's in the repos in scope.",
        "properties": {
          "path": {
            "description": "The task whose tree to list, such as /tasks/ship-flows-editor.md.",
            "title": "Path",
            "type": "string"
          },
          "remote": {
            "description": "A git remote, or owner/name, to choose the repos by in place of the origin of the directory board was started in.",
            "minLength": 1,
            "title": "Remote",
            "type": "string"
          },
          "repo": {
            "description": "One repo's tasks: / for the board's own tree, or a notes repo's mount path such as /repos/notes-personal; the caller's git remote chooses the repos when left out.",
            "title": "Repo",
            "type": "string"
          },
          "root": {
            "description": "Whether to list every top-level node of the repos in scope, with its descendants.",
            "title": "Root",
            "type": "boolean"
          }
        },
        "title": "TreeInput",
        "type": "object"
      },
      "name": "tree",
      "outputSchema": {
        "$defs": {
          "CrossParent": {
            "additionalProperties": false,
            "description": "A `parent` that names a task in another notes repo than its task's own, which is not followed.",
            "properties": {
              "parent": {
                "title": "Parent",
                "type": "string"
              },
              "path": {
                "title": "Path",
                "type": "string"
              }
            },
            "required": [
              "path",
              "parent"
            ],
            "title": "CrossParent",
            "type": "object"
          },
          "CrossRepo": {
            "additionalProperties": false,
            "description": "An `after` that names a task in another notes repo than its task's own, which is not followed.",
            "properties": {
              "after": {
                "title": "After",
                "type": "string"
              },
              "path": {
                "title": "Path",
                "type": "string"
              }
            },
            "required": [
              "path",
              "after"
            ],
            "title": "CrossRepo",
            "type": "object"
          },
          "Subtasks": {
            "additionalProperties": false,
            "description": "How many of a task's descendants are open, and how many it has in every status.",
            "properties": {
              "open": {
                "title": "Open",
                "type": "integer"
              },
              "total": {
                "title": "Total",
                "type": "integer"
              }
            },
            "required": [
              "open",
              "total"
            ],
            "title": "Subtasks",
            "type": "object"
          },
          "TreeNode": {
            "additionalProperties": false,
            "description": "A task in a tree, with its children by title.\n\n`blocked_by` holds its open `after` targets, then its open descendants nearest to it.",
            "properties": {
              "blocked_by": {
                "items": {
                  "type": "string"
                },
                "title": "Blocked By",
                "type": "array"
              },
              "brief": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Brief"
              },
              "children": {
                "items": {
                  "$ref": "#/$defs/TreeNode"
                },
                "title": "Children",
                "type": "array"
              },
              "kind": {
                "title": "Kind",
                "type": "string"
              },
              "owner": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Owner"
              },
              "path": {
                "title": "Path",
                "type": "string"
              },
              "status": {
                "title": "Status",
                "type": "string"
              },
              "subtasks": {
                "$ref": "#/$defs/Subtasks"
              },
              "title": {
                "title": "Title",
                "type": "string"
              },
              "tree_path": {
                "title": "Tree Path",
                "type": "string"
              }
            },
            "required": [
              "path",
              "title",
              "status",
              "kind",
              "brief",
              "owner",
              "blocked_by",
              "subtasks",
              "tree_path",
              "children"
            ],
            "title": "TreeNode",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "A tree, or the top-level trees.\n\nWith `--path`, `tree` is that task's tree. With `--root`, `roots` holds at most 100 top-level nodes, open\nones first and then by title, and `total` counts them all. `repos` are the repos read, `cycles` the tasks\nin them where a loop of `parent` links was cut, and `cross_repo` the references in them to another repo.",
        "properties": {
          "cross_repo": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CrossRepo"
                },
                {
                  "$ref": "#/$defs/CrossParent"
                }
              ]
            },
            "title": "Cross Repo",
            "type": "array"
          },
          "cycles": {
            "items": {
              "type": "string"
            },
            "title": "Cycles",
            "type": "array"
          },
          "repos": {
            "items": {
              "type": "string"
            },
            "title": "Repos",
            "type": "array"
          },
          "roots": {
            "items": {
              "$ref": "#/$defs/TreeNode"
            },
            "title": "Roots",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          },
          "tree": {
            "anyOf": [
              {
                "$ref": "#/$defs/TreeNode"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "tree",
          "roots",
          "total",
          "repos",
          "cycles",
          "cross_repo"
        ],
        "title": "TreeOutput",
        "type": "object"
      }

{
  "$type": "board/plugin-manifest/v1",
  "capabilities": [
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": true
      },
      "description": "The controls that apply to a path.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "The controls that apply to this logical path.",
        "properties": {
          "path": {
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "ForPathInput",
        "type": "object"
      },
      "name": "for-path",
      "outputSchema": {
        "$defs": {
          "Applying": {
            "additionalProperties": false,
            "description": "A control that applies to the path asked about.",
            "properties": {
              "control": {
                "title": "Control",
                "type": "string"
              },
              "purpose": {
                "title": "Purpose",
                "type": "string"
              },
              "requirement": {
                "title": "Requirement",
                "type": "string"
              },
              "rule": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Budget"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "control",
              "requirement",
              "purpose",
              "rule"
            ],
            "title": "Applying",
            "type": "object"
          },
          "Budget": {
            "additionalProperties": false,
            "description": "A limit on the words or bytes of every file the control applies to, summed.\n\nWords are separated by any whitespace.",
            "properties": {
              "budget": {
                "enum": [
                  "words",
                  "bytes"
                ],
                "title": "Budget",
                "type": "string"
              },
              "max": {
                "minimum": 0,
                "title": "Max",
                "type": "integer"
              }
            },
            "required": [
              "budget",
              "max"
            ],
            "title": "Budget",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "The controls that apply to the path, by the control's path.",
        "properties": {
          "controls": {
            "items": {
              "$ref": "#/$defs/Applying"
            },
            "title": "Controls",
            "type": "array"
          }
        },
        "required": [
          "controls"
        ],
        "title": "ForPathOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Check the controls under a path, `/` when left out. Fails naming each control over budget or degraded.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "Check the controls that apply to a file at or under `path`, `/` when left out.",
        "properties": {
          "path": {
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          }
        },
        "title": "CheckInput",
        "type": "object"
      },
      "name": "check",
      "outputSchema": {
        "$defs": {
          "Checked": {
            "additionalProperties": false,
            "description": "A budget control and what all its files use.",
            "properties": {
              "budget": {
                "enum": [
                  "words",
                  "bytes"
                ],
                "title": "Budget",
                "type": "string"
              },
              "control": {
                "title": "Control",
                "type": "string"
              },
              "files": {
                "items": {
                  "type": "string"
                },
                "title": "Files",
                "type": "array"
              },
              "max": {
                "title": "Max",
                "type": "integer"
              },
              "requirement": {
                "title": "Requirement",
                "type": "string"
              },
              "used": {
                "title": "Used",
                "type": "integer"
              }
            },
            "required": [
              "control",
              "requirement",
              "budget",
              "max",
              "used",
              "files"
            ],
            "title": "Checked",
            "type": "object"
          },
          "Stated": {
            "additionalProperties": false,
            "description": "A control without a rule, its patterns, and how many of its files are at or under the path.",
            "properties": {
              "control": {
                "title": "Control",
                "type": "string"
              },
              "files": {
                "title": "Files",
                "type": "integer"
              },
              "paths": {
                "items": {
                  "type": "string"
                },
                "title": "Paths",
                "type": "array"
              },
              "purpose": {
                "title": "Purpose",
                "type": "string"
              },
              "requirement": {
                "title": "Requirement",
                "type": "string"
              }
            },
            "required": [
              "control",
              "requirement",
              "purpose",
              "paths",
              "files"
            ],
            "title": "Stated",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "The controls that apply under the path, by the control's path; each budget is met.",
        "properties": {
          "measured": {
            "items": {
              "$ref": "#/$defs/Checked"
            },
            "title": "Measured",
            "type": "array"
          },
          "stated": {
            "items": {
              "$ref": "#/$defs/Stated"
            },
            "title": "Stated",
            "type": "array"
          }
        },
        "required": [
          "measured",
          "stated"
        ],
        "title": "CheckOutput",
        "type": "object"
      }
    }
  ],
  "description": "Requirements on a board's files, stored as records in the board.",
  "metadata": {
    "area": "governance"
  },
  "name": "controls",
  "run": [
    ".venv/bin/python",
    "-m",
    "board_controls"
  ],
  "types": [
    "controls/control/v1"
  ],
  "version": "0.1.0"
}

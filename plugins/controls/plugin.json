{
  "$type": "board/plugin-manifest/v1",
  "capabilities": [
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": true
      },
      "description": "The controls that apply to a path.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "The controls that apply to this logical path.",
        "properties": {
          "path": {
            "description": "The file to list the controls of, by its logical path, such as /docs/README.md; ask about a new file by the path it will have.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "ForPathInput",
        "type": "object"
      },
      "name": "for-path",
      "outputSchema": {
        "$defs": {
          "Applying": {
            "additionalProperties": false,
            "description": "A control that applies to the path asked about.",
            "properties": {
              "control": {
                "title": "Control",
                "type": "string"
              },
              "purpose": {
                "title": "Purpose",
                "type": "string"
              },
              "requirement": {
                "title": "Requirement",
                "type": "string"
              },
              "rule": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Rule"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "control",
              "requirement",
              "purpose",
              "rule"
            ],
            "title": "Applying",
            "type": "object"
          },
          "Budget": {
            "additionalProperties": false,
            "description": "A limit on the words or bytes of the files the control applies to.\n\nWith `per` `total`, the default, the files' usage is summed; with `file`,\neach file on its own must be within `max`. Words are separated by any\nwhitespace.",
            "properties": {
              "budget": {
                "enum": [
                  "words",
                  "bytes"
                ],
                "title": "Budget",
                "type": "string"
              },
              "max": {
                "minimum": 0,
                "title": "Max",
                "type": "integer"
              },
              "per": {
                "default": "total",
                "enum": [
                  "total",
                  "file"
                ],
                "title": "Per",
                "type": "string"
              }
            },
            "required": [
              "budget",
              "max"
            ],
            "title": "Budget",
            "type": "object"
          },
          "Judged": {
            "additionalProperties": false,
            "description": "A rubric at `judged` that a clean-context model reads the text against.",
            "properties": {
              "judged": {
                "pattern": "^/",
                "title": "Judged",
                "type": "string"
              }
            },
            "required": [
              "judged"
            ],
            "title": "Judged",
            "type": "object"
          },
          "Pattern": {
            "additionalProperties": false,
            "description": "Regular expressions the text must not match, one per line of the file at `pattern`.\n\nWith `show` `match-only`, a finding quotes what matched and never the\nexpression, so the file can stay private; with `pattern`, it names the\nexpression too. Blank lines are skipped.",
            "properties": {
              "pattern": {
                "pattern": "^/",
                "title": "Pattern",
                "type": "string"
              },
              "show": {
                "enum": [
                  "match-only",
                  "pattern"
                ],
                "title": "Show",
                "type": "string"
              }
            },
            "required": [
              "pattern",
              "show"
            ],
            "title": "Pattern",
            "type": "object"
          },
          "Rule": {
            "anyOf": [
              {
                "$ref": "#/$defs/Budget"
              },
              {
                "$ref": "#/$defs/Pattern"
              },
              {
                "$ref": "#/$defs/Judged"
              }
            ]
          }
        },
        "additionalProperties": false,
        "description": "The controls that apply to the path, by the control's path.",
        "properties": {
          "controls": {
            "items": {
              "$ref": "#/$defs/Applying"
            },
            "title": "Controls",
            "type": "array"
          }
        },
        "required": [
          "controls"
        ],
        "title": "ForPathOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Check the controls under a path, `/` when left out. Fails naming each control over budget or degraded.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "Check the controls that apply to a file at or under `path`, `/` when left out.",
        "properties": {
          "path": {
            "description": "The directory or file whose controls to check, by its logical path, such as /docs; / when left out.",
            "format": "board-path",
            "pattern": "^/",
            "title": "Path",
            "type": "string"
          }
        },
        "title": "CheckInput",
        "type": "object"
      },
      "name": "check",
      "outputSchema": {
        "$defs": {
          "Checked": {
            "additionalProperties": false,
            "description": "A budget control and what its files use: all of them summed, or its largest file when `per` is `file`.\n\nOnly a per-file control carries `per`, `largest`, the file it measured\nas `used` (null when it has none), and `over`, every file over `max`.",
            "properties": {
              "budget": {
                "enum": [
                  "words",
                  "bytes"
                ],
                "title": "Budget",
                "type": "string"
              },
              "control": {
                "title": "Control",
                "type": "string"
              },
              "files": {
                "items": {
                  "type": "string"
                },
                "title": "Files",
                "type": "array"
              },
              "largest": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Largest"
              },
              "max": {
                "title": "Max",
                "type": "integer"
              },
              "over": {
                "items": {
                  "$ref": "#/$defs/FileUsed"
                },
                "title": "Over",
                "type": "array"
              },
              "per": {
                "const": "file",
                "title": "Per",
                "type": "string"
              },
              "requirement": {
                "title": "Requirement",
                "type": "string"
              },
              "used": {
                "title": "Used",
                "type": "integer"
              }
            },
            "required": [
              "control",
              "requirement",
              "budget",
              "max",
              "used",
              "files"
            ],
            "title": "Checked",
            "type": "object"
          },
          "FileUsed": {
            "additionalProperties": false,
            "description": "What one file uses of a per-file budget.",
            "properties": {
              "file": {
                "title": "File",
                "type": "string"
              },
              "used": {
                "title": "Used",
                "type": "integer"
              }
            },
            "required": [
              "file",
              "used"
            ],
            "title": "FileUsed",
            "type": "object"
          },
          "Stated": {
            "additionalProperties": false,
            "description": "A control without a budget, its patterns, and how many of its files are at or under the path.",
            "properties": {
              "control": {
                "title": "Control",
                "type": "string"
              },
              "files": {
                "title": "Files",
                "type": "integer"
              },
              "paths": {
                "items": {
                  "type": "string"
                },
                "title": "Paths",
                "type": "array"
              },
              "purpose": {
                "title": "Purpose",
                "type": "string"
              },
              "requirement": {
                "title": "Requirement",
                "type": "string"
              }
            },
            "required": [
              "control",
              "requirement",
              "purpose",
              "paths",
              "files"
            ],
            "title": "Stated",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "The controls that apply under the path, by the control's path; each budget is met.",
        "properties": {
          "measured": {
            "items": {
              "$ref": "#/$defs/Checked"
            },
            "title": "Measured",
            "type": "array"
          },
          "stated": {
            "items": {
              "$ref": "#/$defs/Stated"
            },
            "title": "Stated",
            "type": "array"
          }
        },
        "required": [
          "measured",
          "stated"
        ],
        "title": "CheckOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Check named parts of text against controls' budget, pattern and judged rules, and return each control's verdict on each part with its findings.",
      "env": [
        "BOARD_CONTROLS_AGENT",
        "ANTHROPIC_API_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN"
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "Check each part of text against each control's rule.",
        "properties": {
          "controls": {
            "description": "The controls to check the parts against, by their logical paths in the board's own tree.",
            "items": {
              "pattern": "^/",
              "type": "string"
            },
            "minItems": 1,
            "title": "Controls",
            "type": "array"
          },
          "parts": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Each part of text to check, by its name, such as pr.body.",
            "minProperties": 1,
            "title": "Parts",
            "type": "object"
          }
        },
        "required": [
          "controls",
          "parts"
        ],
        "title": "EvaluateInput",
        "type": "object"
      },
      "name": "evaluate",
      "outputSchema": {
        "$defs": {
          "Evaluated": {
            "additionalProperties": false,
            "description": "One control's verdict on one part.\n\n`status` is `skipped` for a judged rule when the part failed a budget or\npattern rule, and `stated` for a control without a rule. A budget result\ncarries `used` and `max`; a judged result carries `cached`. `omitted`\ncounts the findings left out past the first 20.",
            "properties": {
              "cached": {
                "title": "Cached",
                "type": "boolean"
              },
              "control": {
                "title": "Control",
                "type": "string"
              },
              "findings": {
                "items": {
                  "$ref": "#/$defs/Finding"
                },
                "title": "Findings",
                "type": "array"
              },
              "max": {
                "title": "Max",
                "type": "integer"
              },
              "omitted": {
                "title": "Omitted",
                "type": "integer"
              },
              "part": {
                "title": "Part",
                "type": "string"
              },
              "rule": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Kind"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "$ref": "#/$defs/Status"
              },
              "used": {
                "title": "Used",
                "type": "integer"
              }
            },
            "required": [
              "control",
              "part",
              "rule",
              "status",
              "findings"
            ],
            "title": "Evaluated",
            "type": "object"
          },
          "Finding": {
            "additionalProperties": false,
            "description": "What a rule found wrong in a part: the text at fault, and its line when it has one.\n\nA pattern finding quotes what matched, and names the expression as\n`pattern` only when the rule's `show` is `pattern`. A judged finding\ncarries `rewrite`, the model's instruction for fixing the text.",
            "properties": {
              "line": {
                "title": "Line",
                "type": "integer"
              },
              "pattern": {
                "title": "Pattern",
                "type": "string"
              },
              "rewrite": {
                "title": "Rewrite",
                "type": "string"
              },
              "text": {
                "title": "Text",
                "type": "string"
              }
            },
            "required": [
              "text"
            ],
            "title": "Finding",
            "type": "object"
          },
          "Kind": {
            "enum": [
              "budget",
              "pattern",
              "judged"
            ],
            "type": "string"
          },
          "Status": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "stated"
            ],
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "Each control's verdict on each part, by control as given and then by part; `passed` when none failed.",
        "properties": {
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "results": {
            "items": {
              "$ref": "#/$defs/Evaluated"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "passed",
          "results"
        ],
        "title": "EvaluateOutput",
        "type": "object"
      },
      "timeout": 1800
    }
  ],
  "description": "The controls plugin keeps requirements on files as records in the board that holds the files. Use it when you start work in a board or a repository it mounts, and before you edit a file a control may govern. Start with `board -C <board> call controls.check --path /<directory>`, which lists the budgets it measures and the written requirements under that path. `board -C <board> call controls.for-path --path /<file>` lists the controls on one file. SKILL.md and README.md in the plugin's directory say more.",
  "metadata": {
    "area": "governance"
  },
  "name": "controls",
  "run": [
    ".venv/bin/python",
    "-m",
    "board_controls"
  ],
  "types": [
    "controls/control/v1"
  ],
  "version": "0.1.0"
}

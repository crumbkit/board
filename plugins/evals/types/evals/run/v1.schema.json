{
  "$defs": {
    "Result": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "outcome"
          ]
        },
        {
          "required": [
            "measures"
          ]
        }
      ],
      "description": "What one case gave in a run. A scored case may give `measures` and no `outcome`.\n\n`trial` numbers repeated trials of one case, from 1.",
      "properties": {
        "case": {
          "title": "Case",
          "type": "string"
        },
        "evidence": {
          "items": {
            "format": "board-ref",
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "measures": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Measures",
          "type": "object"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "error",
            "skipped"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "trial": {
          "minimum": 1,
          "title": "Trial",
          "type": "integer"
        }
      },
      "required": [
        "case"
      ],
      "title": "Result",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`evals/run/v1`: one run of an eval, by whom, when, with what versions, and what each case gave.\n\n`versions` maps what was used, such as a model, a prompt or a library, to\nits version. `measures` holds aggregates over the whole run.",
  "properties": {
    "$type": {
      "const": "evals/run/v1",
      "title": "$Type",
      "type": "string"
    },
    "by": {
      "title": "By",
      "type": "string"
    },
    "eval": {
      "format": "board-ref",
      "title": "Eval",
      "type": "string",
      "x-board-type": "evals/eval/v1"
    },
    "finished": {
      "format": "date-time",
      "title": "Finished",
      "type": "string"
    },
    "measures": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Measures",
      "type": "object"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/Result"
      },
      "title": "Results",
      "type": "array"
    },
    "setup": {
      "title": "Setup",
      "type": "string"
    },
    "started": {
      "format": "date-time",
      "title": "Started",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Versions",
      "type": "object"
    }
  },
  "required": [
    "$type",
    "eval",
    "by",
    "started",
    "results"
  ],
  "title": "RunRecord",
  "type": "object"
}

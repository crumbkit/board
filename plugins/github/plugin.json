{
  "$type": "board/plugin-manifest/v1",
  "capabilities": [
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Write the record of a pull request or issue, asking gh which it is and its title, or report the record already there without asking.",
      "env": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_CONFIG_DIR"
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "Record one pull request or issue.",
        "properties": {
          "ref": {
            "description": "The pull request or issue as owner/repo#number, such as octo/widgets#12.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/(\\.?[A-Za-z0-9_-][A-Za-z0-9._-]*)#[1-9][0-9]{0,9}$",
            "title": "Ref",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "title": "RefInput",
        "type": "object"
      },
      "name": "ref",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The record for the reference, and whether this call wrote it.\n\n`written` is false when the record was already there; nothing was asked of\nGitHub and nothing was written. `title` is null when the record holds none.",
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "type": {
            "enum": [
              "github/pull/v1",
              "github/issue/v1"
            ],
            "title": "Type",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          },
          "written": {
            "title": "Written",
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "type",
          "written",
          "url",
          "title"
        ],
        "title": "RefOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Push the branch checked out to origin, once the boundary passes its name and each commit it would send.",
      "env": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_CONFIG_DIR",
        "BOARD_CONTROLS_AGENT",
        "ANTHROPIC_API_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "SSH_AUTH_SOCK"
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "Push the branch checked out to origin, once the boundary passes the commits it would send.",
        "properties": {},
        "title": "PushInput",
        "type": "object"
      },
      "name": "push",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The branch pushed and the commits sent, oldest first; `sent` is git's line for the branch.",
        "properties": {
          "branch": {
            "title": "Branch",
            "type": "string"
          },
          "commits": {
            "items": {
              "type": "string"
            },
            "title": "Commits",
            "type": "array"
          },
          "crossing": {
            "title": "Crossing",
            "type": "string"
          },
          "digest": {
            "title": "Digest",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "sent": {
            "title": "Sent",
            "type": "string"
          }
        },
        "required": [
          "digest",
          "crossing",
          "note",
          "sent",
          "branch",
          "commits"
        ],
        "title": "PushOutput",
        "type": "object"
      },
      "timeout": 2400
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Push the branch checked out and open a pull request from it, once the boundary passes the commits, title and body in one check, and write the pull request's record.",
      "env": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_CONFIG_DIR",
        "BOARD_CONTROLS_AGENT",
        "ANTHROPIC_API_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "SSH_AUTH_SOCK"
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "Push the branch checked out and open a pull request from it, once the boundary passes both.",
        "properties": {
          "base": {
            "description": "The branch to merge into; GitHub's default branch when left out.",
            "minLength": 1,
            "title": "Base",
            "type": "string"
          },
          "body": {
            "description": "The pull request's body, in Markdown.",
            "title": "Body",
            "type": "string"
          },
          "draft": {
            "description": "Whether to open it as a draft.",
            "title": "Draft",
            "type": "boolean"
          },
          "title": {
            "description": "The pull request's title.",
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "body"
        ],
        "title": "PrCreateInput",
        "type": "object"
      },
      "name": "pr-create",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The pushed branch and the pull request opened from it; `sent` is its URL and `path` its record.",
        "properties": {
          "branch": {
            "title": "Branch",
            "type": "string"
          },
          "commits": {
            "items": {
              "type": "string"
            },
            "title": "Commits",
            "type": "array"
          },
          "crossing": {
            "title": "Crossing",
            "type": "string"
          },
          "digest": {
            "title": "Digest",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "sent": {
            "title": "Sent",
            "type": "string"
          }
        },
        "required": [
          "digest",
          "crossing",
          "note",
          "sent",
          "branch",
          "commits",
          "number",
          "path"
        ],
        "title": "PrCreateOutput",
        "type": "object"
      },
      "timeout": 2400
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Change a pull request's title or body, once the boundary passes the new text.",
      "env": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_CONFIG_DIR",
        "BOARD_CONTROLS_AGENT",
        "ANTHROPIC_API_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "SSH_AUTH_SOCK"
      ],
      "inputSchema": {
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "title"
            ]
          },
          {
            "required": [
              "body"
            ]
          }
        ],
        "description": "Change a pull request's title or body, once the boundary passes the new text.",
        "properties": {
          "body": {
            "description": "The new body, in Markdown.",
            "title": "Body",
            "type": "string"
          },
          "number": {
            "description": "The pull request's number in the checkout's repository.",
            "minimum": 1,
            "title": "Number",
            "type": "integer"
          },
          "title": {
            "description": "The new title.",
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "number"
        ],
        "title": "PrEditInput",
        "type": "object"
      },
      "name": "pr-edit",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The crossing the boundary passed, and what GitHub returned for what was sent.\n\n`note` says why nothing was checked, when no boundary covered the content.\n`sent` is what GitHub returned, also recorded on the crossing.",
        "properties": {
          "crossing": {
            "title": "Crossing",
            "type": "string"
          },
          "digest": {
            "title": "Digest",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "sent": {
            "title": "Sent",
            "type": "string"
          }
        },
        "required": [
          "digest",
          "crossing",
          "note",
          "sent"
        ],
        "title": "SentOutput",
        "type": "object"
      },
      "timeout": 2400
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Comment on a pull request or issue, once the boundary passes the comment.",
      "env": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_CONFIG_DIR",
        "BOARD_CONTROLS_AGENT",
        "ANTHROPIC_API_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "SSH_AUTH_SOCK"
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "Comment on a pull request or issue, once the boundary passes the comment.",
        "properties": {
          "body": {
            "description": "The comment, in Markdown.",
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "number": {
            "description": "The pull request's or issue's number in the checkout's repository.",
            "minimum": 1,
            "title": "Number",
            "type": "integer"
          }
        },
        "required": [
          "number",
          "body"
        ],
        "title": "CommentInput",
        "type": "object"
      },
      "name": "comment",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The crossing the boundary passed, and what GitHub returned for what was sent.\n\n`note` says why nothing was checked, when no boundary covered the content.\n`sent` is what GitHub returned, also recorded on the crossing.",
        "properties": {
          "crossing": {
            "title": "Crossing",
            "type": "string"
          },
          "digest": {
            "title": "Digest",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "sent": {
            "title": "Sent",
            "type": "string"
          }
        },
        "required": [
          "digest",
          "crossing",
          "note",
          "sent"
        ],
        "title": "SentOutput",
        "type": "object"
      },
      "timeout": 2400
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Open an issue, once the boundary passes its title and body, and write the issue's record.",
      "env": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_CONFIG_DIR",
        "BOARD_CONTROLS_AGENT",
        "ANTHROPIC_API_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "SSH_AUTH_SOCK"
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "Open an issue in the checkout's repository, once the boundary passes it.",
        "properties": {
          "body": {
            "description": "The issue's body, in Markdown.",
            "title": "Body",
            "type": "string"
          },
          "title": {
            "description": "The issue's title.",
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "body"
        ],
        "title": "IssueCreateInput",
        "type": "object"
      },
      "name": "issue-create",
      "outputSchema": {
        "additionalProperties": false,
        "description": "The issue opened; `sent` is its URL and `path` its record.",
        "properties": {
          "crossing": {
            "title": "Crossing",
            "type": "string"
          },
          "digest": {
            "title": "Digest",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "sent": {
            "title": "Sent",
            "type": "string"
          }
        },
        "required": [
          "digest",
          "crossing",
          "note",
          "sent",
          "number",
          "path"
        ],
        "title": "IssueCreateOutput",
        "type": "object"
      },
      "timeout": 2400
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Install a git pre-push hook in the checkout that has the boundary check what each push sends, refusing to replace a different pre-push hook.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "Install the git pre-push hook in the checkout Board was started in.",
        "properties": {},
        "title": "InstallHookInput",
        "type": "object"
      },
      "name": "install-hook",
      "outputSchema": {
        "additionalProperties": false,
        "description": "Where the hook is, and whether this call wrote it; false when the same hook was already there.",
        "properties": {
          "installed": {
            "title": "Installed",
            "type": "boolean"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "installed"
        ],
        "title": "InstallHookOutput",
        "type": "object"
      }
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Run by the pre-push hook: check the refs git pushes as github.push checks a push, and refuse when the boundary refuses or the check cannot run.",
      "env": [
        "GH_TOKEN",
        "GITHUB_TOKEN",
        "GH_CONFIG_DIR",
        "BOARD_CONTROLS_AGENT",
        "ANTHROPIC_API_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "SSH_AUTH_SOCK",
        "BOARD_GITHUB_PUSH_URL"
      ],
      "inputSchema": {
        "additionalProperties": false,
        "description": "What git gives its pre-push hook: the remote and the refs it pushes. The URL is in BOARD_GITHUB_PUSH_URL.",
        "properties": {
          "refs": {
            "description": "What git writes on the hook's stdin: one `<local ref> <local sha> <remote ref> <remote sha>` per line.",
            "title": "Refs",
            "type": "string"
          },
          "remote": {
            "description": "The remote's name, or the URL git was given in its place.",
            "title": "Remote",
            "type": "string"
          }
        },
        "required": [
          "remote",
          "refs"
        ],
        "title": "PrePushInput",
        "type": "object"
      },
      "name": "pre-push",
      "outputSchema": {
        "$defs": {
          "Checked": {
            "additionalProperties": false,
            "description": "One ref's check against one destination.",
            "properties": {
              "digest": {
                "title": "Digest",
                "type": "string"
              },
              "note": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Note"
              },
              "ref": {
                "title": "Ref",
                "type": "string"
              },
              "to": {
                "title": "To",
                "type": "string"
              }
            },
            "required": [
              "ref",
              "to",
              "digest",
              "note"
            ],
            "title": "Checked",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Each ref checked against each GitHub destination; empty when the push goes nowhere on GitHub or sends nothing.",
        "properties": {
          "checked": {
            "items": {
              "$ref": "#/$defs/Checked"
            },
            "title": "Checked",
            "type": "array"
          }
        },
        "required": [
          "checked"
        ],
        "title": "PrePushOutput",
        "type": "object"
      },
      "timeout": 2400
    },
    {
      "_meta": {},
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Name the boundaries that cover a git push or gh write from the checkout, and where it goes, checking nothing and writing nothing.",
      "inputSchema": {
        "additionalProperties": false,
        "description": "Name the boundaries that cover a write from the checkout, checking nothing.",
        "properties": {
          "action": {
            "description": "The github action that sends the write, such as push or pr-create.",
            "pattern": "^[a-z-]+$",
            "title": "Action",
            "type": "string"
          },
          "remote": {
            "description": "The remote a push names; the branch's push remote, else origin, when left out.",
            "minLength": 1,
            "title": "Remote",
            "type": "string"
          },
          "repo": {
            "description": "The owner/repo the write names, in place of the remote.",
            "title": "Repo",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "title": "CoversInput",
        "type": "object"
      },
      "name": "covers",
      "outputSchema": {
        "$defs": {
          "Covered": {
            "additionalProperties": false,
            "description": "One destination a boundary covers, and the boundaries.",
            "properties": {
              "boundaries": {
                "items": {
                  "type": "string"
                },
                "title": "Boundaries",
                "type": "array"
              },
              "to": {
                "title": "To",
                "type": "string"
              }
            },
            "required": [
              "to",
              "boundaries"
            ],
            "title": "Covered",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Each destination of the write that a boundary covers; empty when none is.",
        "properties": {
          "covered": {
            "items": {
              "$ref": "#/$defs/Covered"
            },
            "title": "Covered",
            "type": "array"
          }
        },
        "required": [
          "covered"
        ],
        "title": "CoversOutput",
        "type": "object"
      }
    }
  ],
  "description": "Record a GitHub pull request or issue as a typed record, and push, open or edit pull requests, comment and open issues only after the boundary passes what they send. Use it to name a pull request or issue in a record, and in place of git push and gh for sending. Run `board call github.ref --ref <owner>/<repo>#<number>`, or `board call github.push`, `github.pr-create`, `github.pr-edit`, `github.comment` or `github.issue-create` from the checkout. SKILL.md and README.md in the plugin's directory say more.",
  "metadata": {
    "area": "delivery"
  },
  "name": "github",
  "run": [
    "uv",
    "run",
    "--frozen",
    "--no-dev",
    "python",
    "-m",
    "board_github"
  ],
  "types": [
    "github/pull/v1",
    "github/issue/v1"
  ],
  "version": "0.1.0"
}

{
  "$defs": {
    "Absent": {
      "additionalProperties": false,
      "description": "A record whose absence a check's `when` needs.",
      "properties": {
        "path": {
          "description": "Where the record would be, its placeholders filled.",
          "pattern": "^/\\S*$",
          "type": "string"
        },
        "type": {
          "description": "The type a record there must have to count.",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+/v[1-9][0-9]*$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "type"
      ],
      "type": "object"
    },
    "Allowed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        }
      ],
      "description": "A value a field may hold: a word or a flag."
    },
    "Answers": {
      "additionalProperties": false,
      "description": "The answers a plan gives, and the answers a check's `when` names; each\nis left out when not given.",
      "properties": {
        "data": {
          "description": "Whether the change stores data.",
          "enum": [
            "none",
            "stored"
          ],
          "type": "string"
        },
        "lifecycle": {
          "description": "Whether anything the change makes changes state.",
          "enum": [
            "none",
            "record"
          ],
          "type": "string"
        },
        "ux": {
          "description": "Whether the change has a UI.",
          "enum": [
            "none",
            "mockups"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "Check": {
      "allOf": [
        {
          "$ref": "#/$defs/SectionsCheck"
        },
        {
          "$ref": "#/$defs/FieldCheck"
        },
        {
          "$ref": "#/$defs/RecordsCheck"
        },
        {
          "$ref": "#/$defs/RunCheck"
        },
        {
          "$ref": "#/$defs/UnderstoodCheck"
        },
        {
          "$ref": "#/$defs/MockupsCheck"
        },
        {
          "$ref": "#/$defs/ObligationsCheck"
        },
        {
          "$ref": "#/$defs/RulePathsCheck"
        },
        {
          "$ref": "#/$defs/PlannedRulePathsCheck"
        },
        {
          "$ref": "#/$defs/ExistsCheck"
        }
      ],
      "description": "One check of a phase: its kind and the kind's parameters, who can make\nit pass, and when it applies.\n\nEach parameter after `waivable` belongs to the kinds its description\nnames, and a check refuses the parameters of every other kind.",
      "properties": {
        "actor": {
          "description": "Who can make the check pass; `agent` when left out.",
          "enum": [
            "agent",
            "owner",
            "reviewer"
          ],
          "type": "string"
        },
        "blocks": {
          "description": "Whether a missing check refuses `advance`; true when left out.",
          "type": "boolean"
        },
        "id": {
          "description": "The check's name, unique in the flow, which `next` reports.",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "kind": {
          "description": "What the check tests.",
          "enum": [
            "sections",
            "field",
            "records",
            "run",
            "paths",
            "tasks",
            "understood",
            "mockups",
            "considered",
            "obligations",
            "rule-paths",
            "planned-rule-paths",
            "flow-valid",
            "exists",
            "controlled-paths",
            "planned-controlled"
          ],
          "type": "string"
        },
        "remedy": {
          "description": "What to do when the check is missing, in place of its kind's own.",
          "minLength": 1,
          "type": "string",
          "x-board-prose": true
        },
        "waivable": {
          "description": "Whether a decision the owner signed may waive the check.",
          "type": "boolean"
        },
        "when": {
          "$ref": "#/$defs/When",
          "description": "When the check applies; always when left out."
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "ExistsCheck": {
      "description": "The parameters of a check of kind `exists`.",
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "path"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "exists"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "properties": {
        "path": {
          "description": "`exists`: where a record must exist.",
          "pattern": "^/\\S*$",
          "type": "string"
        }
      },
      "then": {
        "required": [
          "path"
        ]
      }
    },
    "FieldCheck": {
      "description": "The parameters of a check of kind `field`.",
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "field"
              ]
            },
            {
              "required": [
                "types"
              ]
            },
            {
              "not": {
                "properties": {
                  "kind": {
                    "enum": [
                      "records"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "required": [
                "min"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "field"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "properties": {
        "field": {
          "description": "`field`: the field of the change that must be set.",
          "enum": [
            "task",
            "route",
            "head",
            "plan",
            "tickets",
            "pulls"
          ],
          "type": "string"
        },
        "min": {
          "description": "`field` and `records`: the fewest values or records that pass; one\nwhen left out.",
          "minimum": 1,
          "type": "integer"
        },
        "types": {
          "description": "`field`: the record types the field's references must have.",
          "items": {
            "pattern": "^[a-z0-9-]+/[a-z0-9-]+/v[1-9][0-9]*$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "then": {
        "required": [
          "field"
        ]
      }
    },
    "MockupsCheck": {
      "description": "The parameters of a check of kind `mockups`.",
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "part"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "mockups"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "properties": {
        "part": {
          "description": "`mockups`: the part of the UX section the check reads; both when\nleft out.",
          "enum": [
            "agreed",
            "neighbours"
          ],
          "type": "string"
        }
      }
    },
    "ObligationsCheck": {
      "description": "The parameters of a check of kind `obligations`.",
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "escape_section"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "obligations"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "properties": {
        "escape_section": {
          "description": "`obligations`: the plan's heading under which obligations left owed\nare listed.",
          "minLength": 1,
          "type": "string",
          "x-board-prose": true
        }
      }
    },
    "Phase": {
      "additionalProperties": false,
      "description": "One phase of a flow.",
      "properties": {
        "agent": {
          "description": "Who does the phase's work.",
          "enum": [
            "lead",
            "builder"
          ],
          "type": "string"
        },
        "checks": {
          "description": "The checks that must pass before the change leaves the phase, in the\norder `next` lists them.",
          "items": {
            "$ref": "#/$defs/Check"
          },
          "type": "array"
        },
        "instruction": {
          "description": "What to do in this phase, which `next` returns.",
          "minLength": 1,
          "type": "string",
          "x-board-prose": true
        },
        "name": {
          "description": "The phase's name, which a change's `phase` holds while it is here.",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "skills": {
          "description": "The skills the instruction relies on.",
          "items": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "instruction",
        "checks",
        "agent"
      ],
      "type": "object"
    },
    "PlannedRulePathsCheck": {
      "description": "The parameters of a check of kind `planned-rule-paths`.",
      "else": {
        "not": {
          "anyOf": [
            {
              "not": {
                "properties": {
                  "kind": {
                    "enum": [
                      "rule-paths",
                      "controlled-paths"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "required": [
                "rules"
              ]
            },
            {
              "not": {
                "properties": {
                  "kind": {
                    "enum": [
                      "rule-paths",
                      "controlled-paths"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "required": [
                "controls"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "planned-rule-paths",
              "planned-controlled"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "properties": {
        "controls": {
          "description": "`rule-paths`: the rules whose paths the diff must not touch.\n`planned-rule-paths`: the rules the plan's paths must not reach. A\nflow stored before the rename names it `controls`.",
          "items": {
            "pattern": "^/\\S*$",
            "type": "string"
          },
          "type": "array"
        },
        "rules": {
          "description": "`rule-paths`: the rules whose paths the diff must not touch.\n`planned-rule-paths`: the rules the plan's paths must not reach. A\nflow stored before the rename names it `controls`.",
          "items": {
            "pattern": "^/\\S*$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "rules"
            ]
          },
          {
            "required": [
              "controls"
            ]
          }
        ]
      }
    },
    "RecordsCheck": {
      "description": "The parameters of a check of kind `records`.",
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "type"
              ]
            },
            {
              "not": {
                "properties": {
                  "kind": {
                    "enum": [
                      "field"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "required": [
                "min"
              ]
            },
            {
              "required": [
                "distinct"
              ]
            },
            {
              "required": [
                "where"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "records"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "properties": {
        "distinct": {
          "description": "`records`: the part of each record's `by` that must differ between\nthe records counted.",
          "enum": [
            "by.person",
            "by.program",
            "by.session",
            "by.agent"
          ],
          "type": "string"
        },
        "min": {
          "description": "`field` and `records`: the fewest values or records that pass; one\nwhen left out.",
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "description": "`records`: the type of the attached records the check counts.",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+/v[1-9][0-9]*$",
          "type": "string"
        },
        "where": {
          "$ref": "#/$defs/Where",
          "description": "`records`: what each record counted must meet."
        }
      },
      "then": {
        "required": [
          "type"
        ]
      }
    },
    "RulePathsCheck": {
      "description": "The parameters of a check of kind `rule-paths`.",
      "else": {
        "not": {
          "anyOf": [
            {
              "not": {
                "properties": {
                  "kind": {
                    "enum": [
                      "planned-rule-paths",
                      "planned-controlled"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "required": [
                "rules"
              ]
            },
            {
              "not": {
                "properties": {
                  "kind": {
                    "enum": [
                      "planned-rule-paths",
                      "planned-controlled"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "required": [
                "controls"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "rule-paths",
              "controlled-paths"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "properties": {
        "controls": {
          "description": "`rule-paths`: the rules whose paths the diff must not touch.\n`planned-rule-paths`: the rules the plan's paths must not reach. A\nflow stored before the rename names it `controls`.",
          "items": {
            "pattern": "^/\\S*$",
            "type": "string"
          },
          "type": "array"
        },
        "rules": {
          "description": "`rule-paths`: the rules whose paths the diff must not touch.\n`planned-rule-paths`: the rules the plan's paths must not reach. A\nflow stored before the rename names it `controls`.",
          "items": {
            "pattern": "^/\\S*$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "rules"
            ]
          },
          {
            "required": [
              "controls"
            ]
          }
        ]
      }
    },
    "RunCheck": {
      "description": "The parameters of a check of kind `run`.",
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "scope"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "run"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "properties": {
        "scope": {
          "description": "`run`: the scope the run must have.",
          "enum": [
            "full",
            "targeted"
          ],
          "type": "string"
        }
      }
    },
    "SectionsCheck": {
      "description": "The parameters of a check of kind `sections`.",
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "sections"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "sections"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "properties": {
        "sections": {
          "description": "`sections`: the plan's headings that must each have text.",
          "items": {
            "type": "string",
            "x-board-prose": true
          },
          "type": "array"
        }
      },
      "then": {
        "required": [
          "sections"
        ]
      }
    },
    "Stop": {
      "description": "Where a run stops: `through` a phase does its work and stops before\nleaving it; `until` a phase moves into it and stops before its work.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "through": {
              "description": "The phase to stop in, after its work.",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "through"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "until": {
              "description": "The phase to stop at, before its work.",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "until"
          ],
          "type": "object"
        }
      ]
    },
    "Target": {
      "anyOf": [
        {
          "description": "A target named by a word.",
          "enum": [
            "plan",
            "change"
          ],
          "type": "string"
        },
        {
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+/v[1-9][0-9]*$",
          "type": "string"
        }
      ],
      "description": "What a record's `refs` must name: the change's `plan` (its plan record,\nthe plan's text or the change), the `change`, or an attached record of\na type."
    },
    "UnderstoodCheck": {
      "description": "The parameters of a check of kind `understood`.",
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "subject"
              ]
            },
            {
              "required": [
                "rechecks"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "understood"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "properties": {
        "rechecks": {
          "description": "`understood`: the fewest points whose latest recheck matches the\nplan that each attached understanding check holds.",
          "minimum": 1,
          "type": "integer"
        },
        "subject": {
          "description": "`understood`: what the understanding check covers.",
          "enum": [
            "data",
            "ux"
          ],
          "type": "string"
        }
      },
      "then": {
        "required": [
          "subject"
        ]
      }
    },
    "When": {
      "additionalProperties": false,
      "description": "When a check applies: every condition given holds.",
      "properties": {
        "absent": {
          "$ref": "#/$defs/Absent",
          "description": "No record of this type that Board reads is at this path."
        },
        "answers": {
          "$ref": "#/$defs/Answers",
          "description": "The plan's typed answers each equal the one given here."
        },
        "route": {
          "description": "The change's route is one of these.",
          "items": {
            "description": "Who must agree to the change before it is built: `owner` when no one\nelse owns its files, `ask-first` when someone else does, and `unowned`\nwhen the repository names no owners.",
            "enum": [
              "owner",
              "ask-first",
              "unowned"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "section": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string",
            "x-board-regex": true
          },
          "description": "The text under each of these plan headings matches its pattern,\nwithout case.",
          "type": "object"
        },
        "section_not": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string",
            "x-board-regex": true
          },
          "description": "The text under each of these plan headings does not match its\npattern, without case.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "Where": {
      "additionalProperties": false,
      "description": "What each record a `records` check counts must meet.",
      "properties": {
        "at_head": {
          "description": "The field whose commit must be the change's head.",
          "enum": [
            "range"
          ],
          "type": "string"
        },
        "no_findings": {
          "description": "The severities none of the record's findings may have.",
          "items": {
            "description": "A finding's severity.",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "owner_signed": {
          "description": "Whether the owner wrote the record himself, so its `written_by` is\nempty.",
          "type": "boolean"
        },
        "refs": {
          "description": "What the record's `refs` must each name.",
          "items": {
            "$ref": "#/$defs/Target"
          },
          "type": "array"
        },
        "values": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Allowed"
            },
            "type": "array"
          },
          "description": "For each field, the values it may hold.",
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`changes/flow/v1`: a process a change follows from its first phase to\ndone.\n\nA change moves through `phases` in order and then to `done`. `stop` is\nwhere an agent that runs the flow stops by default.",
  "properties": {
    "$type": {
      "const": "changes/flow/v1",
      "description": "The record's type.",
      "type": "string"
    },
    "name": {
      "description": "The flow's name, such as `development`.",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "phases": {
      "description": "The phases in order; `done` follows the last.",
      "items": {
        "$ref": "#/$defs/Phase"
      },
      "minItems": 1,
      "type": "array"
    },
    "stop": {
      "$ref": "#/$defs/Stop",
      "description": "Where an agent that runs the flow stops unless told otherwise."
    },
    "summary": {
      "description": "What the flow is for, in a sentence.",
      "minLength": 1,
      "type": "string",
      "x-board-prose": true
    }
  },
  "required": [
    "$type",
    "name",
    "summary",
    "stop",
    "phases"
  ],
  "title": "Flow",
  "type": "object",
  "x-board-folder": "/flows/"
}

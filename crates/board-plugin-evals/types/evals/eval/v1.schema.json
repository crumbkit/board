{
  "additionalProperties": false,
  "description": "`evals/eval/v1`: a question about some subjects, how it is tested, what\nit rests on, and what was concluded. A `concluded` eval has a `verdict`.",
  "if": {
    "properties": {
      "status": {
        "const": "concluded"
      }
    },
    "required": [
      "status"
    ]
  },
  "properties": {
    "$type": {
      "const": "evals/eval/v1",
      "description": "The record's type.",
      "type": "string"
    },
    "conclusion": {
      "description": "What was concluded, in words.",
      "type": "string"
    },
    "decision": {
      "description": "The decision this eval informs.",
      "type": "string"
    },
    "mounts": {
      "description": "The mount of each repository the eval concerns, such as\n`/repos/crumbkit`.",
      "items": {
        "format": "board-ref",
        "type": "string"
      },
      "type": "array"
    },
    "question": {
      "description": "The question the eval answers.",
      "type": "string"
    },
    "runs": {
      "description": "The runs its verdict rests on.",
      "items": {
        "format": "board-ref",
        "type": "string",
        "x-board-type": "runs/run/v1"
      },
      "type": "array"
    },
    "status": {
      "description": "Where the eval stands.",
      "enum": [
        "planned",
        "running",
        "concluded",
        "abandoned"
      ],
      "type": "string"
    },
    "subjects": {
      "description": "The names of what is tested, such as `crumbkit` or `clap`, without\nversions. Name a repository by its mount, in `mounts`.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "suites": {
      "description": "The suites that say how the eval is tested.",
      "items": {
        "format": "board-ref",
        "type": "string",
        "x-board-type": "runs/suite/v1"
      },
      "type": "array"
    },
    "verdict": {
      "description": "What the runs show.",
      "enum": [
        "supported",
        "refuted",
        "inconclusive"
      ],
      "type": "string"
    },
    "written_by": {
      "description": "The plugin and hook that wrote this record, such as runs/test-run;\nabsent when an agent or a person wrote it.",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
      "type": "string"
    }
  },
  "required": [
    "$type",
    "question",
    "subjects",
    "status"
  ],
  "then": {
    "required": [
      "verdict"
    ]
  },
  "title": "EvalRecord",
  "type": "object"
}

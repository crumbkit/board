{
  "Actor": {
    "additionalProperties": false,
    "description": "Who wrote a record or acted: the session, the program, the person and\nthe agent's name, each when known, and at least one. Every record type that names who\nacted holds one.",
    "minProperties": 1,
    "properties": {
      "agent": {
        "description": "The name the agent was given, such as `nightly scheduler`, as\nfree text.",
        "type": "string",
        "x-board-prose": true
      },
      "person": {
        "description": "The person who acted, such as `luke`, or their email address.",
        "pattern": "^([a-z0-9]+(-[a-z0-9]+)*|[^@\\s]+@[^@\\s]+)$",
        "type": "string"
      },
      "program": {
        "description": "The program that acted, such as `claude-code` or `codex`.",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "type": "string"
      },
      "session": {
        "description": "The Claude Code session's `local_` id.",
        "pattern": "^local_[0-9a-f-]+$",
        "type": "string"
      }
    },
    "type": "object"
  },
  "CommitName": {
    "pattern": "^[0-9a-f]{7,40}$",
    "type": "string"
  },
  "Date": {
    "format": "date",
    "type": "string"
  },
  "Digest": {
    "pattern": "^sha256:[0-9a-f]{64}$",
    "type": "string"
  },
  "Glob": {
    "minLength": 1,
    "type": "string",
    "x-board-glob": true
  },
  "LogicalGlob": {
    "minLength": 1,
    "pattern": "^/",
    "type": "string",
    "x-board-glob": true
  },
  "ObjectId": {
    "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
    "type": "string"
  },
  "PathTemplate": {
    "pattern": "^/\\S*$",
    "type": "string"
  },
  "Pattern": {
    "minLength": 1,
    "type": "string",
    "x-board-regex": true
  },
  "Person": {
    "pattern": "^([a-z0-9]+(-[a-z0-9]+)*|[^@\\s]+@[^@\\s]+)$",
    "type": "string"
  },
  "Pinned": {
    "additionalProperties": false,
    "description": "A reference to a record pinned to the git blob it was read at, such as\nthe brief a review read.",
    "properties": {
      "blob": {
        "description": "The git blob id of the record as it was read.",
        "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
        "type": "string"
      },
      "record": {
        "description": "The record.",
        "format": "board-ref",
        "type": "string"
      }
    },
    "required": [
      "record",
      "blob"
    ],
    "type": "object"
  },
  "Prose": {
    "type": "string",
    "x-board-prose": true
  },
  "Repository": {
    "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$",
    "type": "string"
  },
  "SessionId": {
    "pattern": "^local_[0-9a-f-]+$",
    "type": "string"
  },
  "Slug": {
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "type": "string"
  },
  "Subject": {
    "pattern": "^([A-Za-z0-9-]+/[A-Za-z0-9._-]+|/\\S+)$",
    "type": "string"
  },
  "Summary": {
    "pattern": "^\\S+( \\S+){0,24}$",
    "type": "string"
  },
  "TypeName": {
    "pattern": "^[a-z0-9-]+/[a-z0-9-]+/v[1-9][0-9]*$",
    "type": "string"
  },
  "Url": {
    "format": "uri",
    "pattern": "^https?://([^/?#@]*@)?[^/?#@:][^/?#@]*([/?#]|$)",
    "type": "string"
  }
}

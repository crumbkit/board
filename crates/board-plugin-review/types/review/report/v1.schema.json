{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "description": "Who wrote a record or acted: the session, the program, the person and\nthe agent's name, each when known, and at least one. Every record type that names who\nacted holds one.",
      "minProperties": 1,
      "properties": {
        "agent": {
          "description": "The name the agent was given, such as `nightly scheduler`, as\nfree text.",
          "type": "string",
          "x-board-prose": true
        },
        "person": {
          "description": "The person who acted, such as `luke`, or their email address.",
          "pattern": "^([a-z0-9]+(-[a-z0-9]+)*|[^@\\s]+@[^@\\s]+)$",
          "type": "string"
        },
        "program": {
          "description": "The program that acted, such as `claude-code` or `codex`.",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "session": {
          "description": "The Claude Code session's `local_` id.",
          "pattern": "^local_[0-9a-f-]+$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Cost": {
      "additionalProperties": false,
      "description": "What a review took: its seconds, and its tokens when a model ran and said.",
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "seconds": {
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
        }
      },
      "required": [
        "seconds"
      ],
      "title": "Cost",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "One thing a review found, at a file and line when it has one.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "severity": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "text"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Pinned": {
      "additionalProperties": false,
      "description": "A reference to a record pinned to the git blob it was read at, such as\nthe brief a review read.",
      "properties": {
        "blob": {
          "description": "The git blob id of the record as it was read.",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
          "type": "string"
        },
        "record": {
          "description": "The record.",
          "format": "board-ref",
          "type": "string"
        }
      },
      "required": [
        "record",
        "blob"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "patch_ids": [
      "range"
    ],
    "range": [
      "patch_ids"
    ]
  },
  "description": "`review/report/v1`, at /reviews/<id>/report: what one review of a range or a record found.\n\n`range` holds the full commit ids reviewed, and `patch_ids` the\n`git patch-id --verbatim` of each commit in it that has a diff, oldest first,\nso the review still covers the commits after a rebase. A review of a record\nholds its `subject` instead, and covers no commit. `brief` is absent for\na review a person wrote. `by` names who reviewed: the program the agent\ncommand starts, its session, or the person. `source` is a URL, such as\na GitHub review. `follows` is the previous report.",
  "oneOf": [
    {
      "required": [
        "range"
      ]
    },
    {
      "required": [
        "subject"
      ]
    }
  ],
  "properties": {
    "$type": {
      "const": "review/report/v1",
      "title": "$Type",
      "type": "string"
    },
    "brief": {
      "format": "board-ref",
      "title": "Brief",
      "type": "string",
      "x-board-type": "review/brief/v1"
    },
    "by": {
      "$ref": "#/$defs/Actor"
    },
    "cost": {
      "$ref": "#/$defs/Cost"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "follows": {
      "format": "board-ref",
      "title": "Follows",
      "type": "string",
      "x-board-type": "review/report/v1"
    },
    "patch_ids": {
      "items": {
        "pattern": "^[0-9a-f]{40,64}$",
        "type": "string"
      },
      "title": "Patch Ids",
      "type": "array"
    },
    "range": {
      "pattern": "^[0-9a-f]{40,64}\\.\\.[0-9a-f]{40,64}$",
      "title": "Range",
      "type": "string"
    },
    "source": {
      "pattern": "^https?://",
      "title": "Source",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/Pinned"
    },
    "verdict": {
      "enum": [
        "approve",
        "changes",
        "comment"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "$type",
    "findings",
    "verdict"
  ],
  "title": "ReportRecord",
  "type": "object"
}

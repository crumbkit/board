{
  "$type": "controls/control/v2",
  "summary": "A plan that says None under Data edits no data path.",
  "requirement": "When the plan says None under Data, the diff edits no file /controls/{repo}/data-paths lists.",
  "purpose": "A data edit needs the owner's signed understanding check, which None skipped.",
  "subject": {
    "of": "diff",
    "within": [
      "/controls/{repo}/data-paths"
    ]
  },
  "when": {
    "section": {
      "Data": "^none\\s*(?:[.:]|\\n?\\z)"
    }
  },
  "trigger": "transition",
  "expectations": [
    {
      "checker": "program",
      "rule": {
        "check": "untouched"
      }
    }
  ],
  "on_failure": {
    "action": "block",
    "remedy": "Revert the edits to the controlled paths, or move the change to a flow that allows them with `board changes reflow --path {change} --flow <flow>`."
  }
}

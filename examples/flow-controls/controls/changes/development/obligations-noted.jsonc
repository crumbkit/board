{
  "$type": "controls/control/v2",
  "summary": "The plan accounts for every obligation on its paths.",
  "requirement": "Every obligation control that applies to the plan's paths is listed in the plan's owed field.",
  "purpose": "Owed work is seen at planning time, while it is still cheap to include.",
  "subject": {
    "of": "plan-paths"
  },
  "trigger": "transition",
  "expectations": [
    {
      "checker": "program",
      "rule": {
        "check": "obligations-owed"
      }
    }
  ],
  "on_failure": {
    "action": "warn",
    "remedy": "Do the work each obligation names. Once the work is committed, delete each obligation with `board rm <path> -m '<message naming the work>'`; merging the work does not clear it. List an obligation the change leaves owed in the plan's owed field."
  }
}
